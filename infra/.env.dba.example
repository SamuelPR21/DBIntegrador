# SOLO PARA EL DBA. Copia como .env.dba (NUNCA se sube al repo).
# Lo usa scripts/actualizar_roles_qa.sh para exportar roles de DEV y permisos de QA de TEST.
# Si un clúster corre en tu mismo PC, usa host.docker.internal en vez de localhost.

# ---- Clúster DEV (de aquí salen los roles) ----
DEV_HOST=
DEV_PORT=
DEV_DB=pecuario
DEV_USER=dba
DEV_PASSWORD=

# ---- Clúster TEST (de aquí salen los permisos de rol_qa) ----
TEST_HOST= 
TEST_PORT=
TEST_DB=pecuario
TEST_USER=dba
TEST_PASSWORD=

# ---- Opcionales ----
# PG_IMAGE=postgres:18.0
# QA_ROLE=rol_qa
