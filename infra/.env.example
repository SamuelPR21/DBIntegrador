# Copia este archivo como .env y llena los valores (pídelos al DBA).
# El archivo .env NUNCA se sube al repo.

# Superusuario del contenedor local
POSTGRES_PASSWORD=

# Nombre de la base (debe coincidir con el de DEV para que las cadenas de conexión sirvan)
POSTGRES_DB=pecuario

# Puerto en tu PC (5433 para no chocar con un Postgres instalado)
DB_PORT=5433

# Contraseña de member_qa (consultas manuales, pytest)
QA_PASSWORD=

# Contraseña de sgpmp_app (backend local para Postman / Newman / Cypress)
APP_PASSWORD=
